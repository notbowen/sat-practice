# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A local SAT revision and practice tool"
description:
  "A localhost-only SAT revision tool backed by SQLite and the College Board question bank"
authors: ["Hu Bowen <contact@hubowen.dev>"]
license: "MIT"
tags: ["sat" "revision" "practice" "education"]
homepage: "https://github.com/notbowen/sat-practice"
bug-reports: "https://github.com/notbowen/sat-practice/issues"
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.24"}
  "dream"
  "caqti" {>= "2.0" & < "3.0"}
  "caqti-lwt" {>= "2.0" & < "3.0"}
  "caqti-driver-sqlite3"
  "cohttp-lwt-unix"
  "lwt"
  "yojson"
  "uri"
  "argon2"
  "digestif"
  "mirage-crypto-rng"
  "ptime"
  "markup"
  "lambdasoup"
  "alcotest"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/notbowen/sat-practice.git"
x-maintenance-intent: ["(latest)"]
